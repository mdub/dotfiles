#! /bin/bash

# Register this directory as a local pi package. Pi loads it in place, so
# edits here take effect on the next `/reload`.

set -euo pipefail

# CDPATH is exported in this environment, which makes `cd` echo its target;
# blank it so the command substitution captures only `pwd`.
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

# Remove symlinks left by the previous, symlink-based setup.
for link in "$agent_dir"/themes/*.json "$agent_dir"/extensions/*.ts; do
  if [ -L "$link" ] && [[ "$(readlink "$link")" == "$here"/* ]]; then
    rm "$link"
    echo "removed old symlink $link"
  fi
done

pi install "$here"
